# Biến môi trường của stack local (docker/compose.yaml). `make env` copy file này thành docker/.env (không commit).
POSTGRES_PASSWORD=geolife-local
# Model version mà API serve: models:/geolife_home_office/<version> (version nào là thuật toán nào: xem MLflow UI)
MODEL_URI=models:/geolife_home_office/1
