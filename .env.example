# Biến môi trường local, dùng cho Makefile và geolife.register. `make env` copy thành .env (không commit).
POSTGRES_PASSWORD=geolife-local

DATABRICKS_HOST=https://<id>.cloud.databricks.com
DATABRICKS_TOKEN=

MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_EXPERIMENT_NAME=/Users/<email>/geolife_home_office
MLFLOW_MODEL_NAME=workspace.geolife.geolife_home_office

# version đang serve; version nào là thuật toán nào: xem tag của version
MODEL_URI=models:/workspace.geolife.geolife_home_office/1
